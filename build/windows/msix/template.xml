<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="import_manager.exe"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\Import Manager">
    </Installer>
    <PackageInformation
        PackageName="Import Manager"
        PackageDisplayName="Import Manager"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="1.0.0.0"
        PackageDescription="Import Manager Next Generation ERP">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.janayuv.importmanager"
                Description="Import Manager Next Generation ERP"
                DisplayName="Import Manager"
                ExecutableName="import_manager.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Import Manager</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>Import Manager Next Generation ERP</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="import_manager.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
